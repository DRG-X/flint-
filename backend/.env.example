# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev default — no value needed):
# DATABASE_URL=sqlite:///./flint.db
# PostgreSQL (Railway / production):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Clerk Authentication ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
ADMIN_CLERK_IDS=clerk_user_id_1,clerk_user_id_2

# Clerk JWKS endpoint — required for JWT verification in auth.py
# Find your JWKS URL at: Clerk Dashboard → Configure → API Keys → Advanced → JWT public key URL
# Format: https://YOUR_CLERK_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# ── Upstash Redis Cache ────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example: ALLOWED_ORIGINS=https://yourapp.vercel.app
# Add multiple origins: ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourapp-git-main.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
